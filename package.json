{
  "name": "electron-fiddle-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "yarn workspace electron-fiddle start",
    "start:xvfb": "yarn workspace electron-fiddle start:xvfb",
    "generate": "yarn workspace electron-fiddle generate",
    "i18n:check": "yarn workspace electron-fiddle i18n:check",
    "i18n:translate": "yarn workspace electron-fiddle i18n:translate",
    "i18n:test": "yarn workspace electron-fiddle i18n:test",
    "typecheck": "yarn generate && tsc -b",
    "lint": "yarn generate && eslint --cache .",
    "lint:fix": "yarn generate && eslint --cache --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "yarn generate && vitest run",
    "test:watch": "vitest",
    "test:e2e": "yarn generate && vitest run -c packages/app/e2e/vitest.config.mts",
    "driver": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON packages/app/tools/driver.ts",
    "fiddle": "node packages/app/tools/fiddle-cli.mjs",
    "package": "yarn workspace electron-fiddle package",
    "make": "yarn workspace electron-fiddle make"
  },
  "resolutions": {
    "@electron-forge/maker-base": "8.0.0-alpha.10",
    "@electron-forge/shared-types": "8.0.0-alpha.10",
    "electron-windows-msix@npm:^2.0.4": "patch:electron-windows-msix@npm%3A2.0.4#~/.yarn/patches/electron-windows-msix-npm-2.0.4-954aec946e.patch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.9.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "^2.4.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "8.2.2",
    "vitest": "^5.0.0"
  }
}
