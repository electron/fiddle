{
  "name": "electron-fiddle",
  "productName": "Electron Fiddle",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "The easiest way to get started with Electron",
  "repository": "https://github.com/electron/fiddle",
  "homepage": "https://electronjs.org/fiddle",
  "author": "Electron Community",
  "license": "MIT",
  "main": ".vite/build/main.js",
  "scripts": {
    "postinstall": "install-electron",
    "generate": "node tools/generate.mjs",
    "i18n:check": "node tools/i18n-check.mjs",
    "i18n:translate": "node tools/i18n-translate.mjs",
    "i18n:test": "node --test tools/i18n-translate.test.mjs",
    "start": "node tools/generate.mjs && electron-forge start",
    "start:xvfb": "node tools/generate.mjs && node tools/start-headless.mjs",
    "fiddle": "node tools/fiddle-cli.mjs",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "driver": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/driver.ts",
    "driver:build": "node tools/generate.mjs && node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/driver-build.ts",
    "driver:release-check": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/driver-release-check.ts",
    "features-coverage": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON e2e/features-coverage.ts"
  },
  "dependencies": {
    "@electron-internal/extract-zip": "^1.0.1",
    "@electron/fiddle-core": "workspace:*",
    "@marshallofsound/ipc": "^2.7.1",
    "@sentry/electron": "^7.18.0",
    "i18next": "^26.4.2",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "semver": "^7.8.5",
    "sfw": "2.0.6",
    "update-electron-app": "^3.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.0-alpha.10",
    "@electron-forge/maker-deb": "8.0.0-alpha.10",
    "@electron-forge/maker-msix": "8.0.0-alpha.10",
    "@electron-forge/maker-rpm": "8.0.0-alpha.10",
    "@electron-forge/maker-squirrel": "8.0.0-alpha.10",
    "@electron-forge/maker-zip": "8.0.0-alpha.10",
    "@electron-forge/plugin-fuses": "8.0.0-alpha.10",
    "@electron-forge/plugin-vite": "8.0.0-alpha.10",
    "@electron-forge/publisher-github": "8.0.0-alpha.10",
    "@electron-forge/shared-types": "8.0.0-alpha.10",
    "@electron/fuses": "^2.1.3",
    "@reforged/maker-appimage": "^5.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "vite": "8.2.2"
  }
}
