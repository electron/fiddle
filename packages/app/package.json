{
  "name": "electron-fiddle",
  "productName": "Electron Fiddle",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "The easiest way to get started with Electron",
  "repository": "https://github.com/electron/fiddle",
  "homepage": "https://electronjs.org/fiddle",
  "author": "Electron Community",
  "license": "MIT",
  "main": ".vite/build/main.js",
  "scripts": {
    "generate": "node tools/generate.mjs",
    "start": "node tools/generate.mjs && electron-forge start",
    "start:xvfb": "node tools/generate.mjs && node tools/start-headless.mjs",
    "package": "node tools/generate.mjs && electron-forge package",
    "make": "node tools/generate.mjs && electron-forge make"
  },
  "dependencies": {
    "@electron/fiddle-core": "workspace:*",
    "@marshallofsound/ipc": "^2.7.1",
    "@sentry/electron": "^7.18.0",
    "i18next": "^26.4.2",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "semver": "^7.8.5",
    "update-electron-app": "^3.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.0-alpha.10",
    "@electron-forge/maker-deb": "8.0.0-alpha.10",
    "@electron-forge/maker-rpm": "8.0.0-alpha.10",
    "@electron-forge/maker-squirrel": "8.0.0-alpha.10",
    "@electron-forge/maker-zip": "8.0.0-alpha.10",
    "@electron-forge/plugin-fuses": "8.0.0-alpha.10",
    "@electron-forge/plugin-vite": "8.0.0-alpha.10",
    "@electron-forge/shared-types": "8.0.0-alpha.10",
    "@electron/fuses": "^2.1.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "vite": "8.2.2"
