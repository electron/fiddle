module fiddle

// Every interface is limited to the app's own main frame: app://main, or in an
// unpackaged app the Vite dev server on http://localhost.
validator MainFrame = AND(
    is_main_frame is true
    OR(
        origin is "app://main"
        AND(
            is_packaged is false
            protocol is "http:"
            hostname is "localhost"
        )
    )
)

// Import paths are relative to generated/_internal/<kind>/, where they are emitted.
zod_reference AppState {
    import = "../../../../shared/stores"
    type = "AppState"
    schema = "appStateSchema"
}

zod_reference WindowState {
    import = "../../../../shared/stores"
    type = "WindowState"
    schema = "windowStateSchema"
}

subtype CommandId = string(
    minLength: 1
    maxLength: 100
)

zod_reference FocusContext {
    import = "../../../../shared/settings"
    type = "FocusContext"
    schema = "focusContextSchema"
}

// A `Window.menuBar` entry: a command ID, `role:<role>`, `recent:<n>` or `example:<name>`.
subtype MenuItemId = string(
    minLength: 1
    maxLength: 300
)

structure AppInfo {
    name: string
    version: string
    electronVersion: string
}

// Shared state and app-wide methods.
[RendererAPI]
[Validator=MainFrame]
[ContextBridge]
interface App {
    // useAppStore() in the renderer; StateHub pushes it with updateAppStore.
    [Store]
    App() -> AppState

    GetAppInfo() -> AppInfo
}

// Per-window state and methods. Bound with .for(webContents); handlers close
// over the window's ID, so renderers never send one.
[RendererAPI]
[Validator=MainFrame]
[ContextBridge]
interface Window {
    // useWindowStore() in the renderer; StateHub pushes it with updateWindowStore.
    [Store]
    Window() -> WindowState

    // The renderer has read both stores and painted; main shows the window.
    ReportReady()

    // Runs a command from the registry in the context of this window.
    RunCommand(id: CommandId)

    // macOS: empty title bar space was double-clicked. Main minimizes or zooms
    // the window, as the system preference says.
    DoubleClickTitleBar()

    // A context menu is about to open over the editor, the console or anything
    // else. Sent during the DOM event, so it reaches main before Chromium's
    // `context-menu` event on the same channel.
    ReportContextMenu(context: FocusContext)

    // Windows and Linux: an item of the title bar's menu bar (`Window.menuBar`)
    // was chosen. Main does what the same item of the native menu does: runs
    // the command, the role, or opens the recent folder or example.
    ActivateMenuItem(id: MenuItemId)

    // Main's one channel to the window: commands whose handlers act on Monaco,
    // view state or a dialog there.
    [Event]
    Command(id: CommandId)
}

// The fiddle in each window, its editor mirror and loading.

zod_reference FileMapValue {
    import = "../../../../shared/stores"
    type = "FileMapValue"
    schema = "fileMapSchema"
}

zod_reference WindowLayout {
    import = "../../../../shared/stores"
    type = "WindowLayout"
    schema = "windowLayoutSchema"
}

zod_reference WindowView {
    import = "../../../../shared/stores"
    type = "WindowView"
    schema = "windowViewSchema"
}

subtype FileName = string(
    minLength: 1
    maxLength: 255
)

subtype ShortText = string(
    minLength: 1
    maxLength: 2048
)

// Change methods return the Window store `rev` that includes the change.
[RendererAPI]
[Validator=MainFrame]
[ContextBridge]
interface Documents {
    // Every file's text from main's editor mirror, hidden files included.
    GetFiles() -> FileMapValue

    // The renderer's Monaco text for one file. Dropped if `fiddleRev` is stale.
    EditFile(name: FileName, text: string, fiddleRev: number) -> number

    AddFile(name: FileName) -> number
    RenameFile(oldName: FileName, newName: FileName) -> number
    RemoveFile(name: FileName) -> number
    SetFileVisible(name: FileName, visible: boolean) -> number
    SetActiveFile(name: FileName) -> number
    // Moves a file (its tab and sidebar row) in front of `before`, or to the end.
    MoveFile(name: FileName, before: FileName?) -> number
    SetLayout(layout: WindowLayout) -> number
    SetView(view: WindowView) -> number

    // Loads a gist by URL or ID, optionally at a revision SHA. Asks about
    // unsaved changes first. Returns the Window rev after the load.
    LoadGist(idOrUrl: ShortText, revision: string?) -> number
    // Loads a Show Me example by name.
    LoadExample(name: ShortText) -> number
    // Text dropped on the window: a gist URL or an electron-fiddle:// link.
    OpenDropped(text: ShortText)
}

// Settings: settings.json, themes and keybinding overrides.

zod_reference SettingKey {
    import = "../../../../shared/settings"
    type = "SettingKey"
    schema = "settingKeySchema"
}

// Validated against the key's schema in main.
zod_reference SettingValue {
    import = "../../../../shared/settings"
    type = "SettingValue"
    schema = "settingValueSchema"
}

zod_reference ThemeData {
    import = "../../../../shared/settings"
    type = "ThemeData"
    schema = "themeDataSchema"
}

// A built-in theme as the renderer draws it, for "Create from current".
zod_reference ThemeSnapshot {
    import = "../../../../shared/settings"
    type = "ThemeSnapshot"
    schema = "themeSnapshotSchema"
}

subtype ThemeId = string(
    minLength: 1
    maxLength: 100
)

subtype NoticeId = string(
    minLength: 1
    maxLength: 100
)

// Change methods return the App store `rev` that includes the change.
[RendererAPI]
[Validator=MainFrame]
[ContextBridge]
interface Settings {
    SetSetting(key: SettingKey, value: SettingValue) -> number
    ResetSetting(key: SettingKey) -> number
    // Opens settings.json in the default editor. Outside edits apply live.
    OpenSettingsFile()
    // File dialogs. Import returns null when cancelled.
    ImportSettings() -> number?
    ExportSettings()
    DismissStorageNotice(id: NoticeId) -> number

    // A custom theme's data, or null if it's gone.
    GetTheme(id: ThemeId) -> ThemeData?
    // Rescans <userData>/themes/.
    RefreshThemes() -> number
    // Imports a Monaco theme JSON file and selects it. Null when cancelled.
    ImportTheme() -> number?
    // Writes a theme file from the current theme, selects it and reveals it.
    // `builtin` is the built-in theme's current values; null for a custom theme.
    CreateTheme(builtin: ThemeSnapshot?) -> number
    OpenThemesFolder()
}

// npm modules and the onboarding tour.

zod_reference PackageSearchResults {
    import = "../../../../shared/stores"
    type = "PackageSearchResults"
    schema = "packageSearchResultsSchema"
}

zod_reference PackageVersions {
    import = "../../../../shared/stores"
    type = "PackageVersions"
    schema = "packageVersionsSchema"
}

subtype PackageName = string(
    minLength: 1
    maxLength: 214
)

subtype PackageQuery = string(
    minLength: 1
    maxLength: 214
)

subtype VersionSpec = string(
    minLength: 1
    maxLength: 256
)

// The fiddle's modules live in `Window.fiddle.modules`. Change methods return
// the Window store `rev` that includes the change.
[RendererAPI]
[Validator=MainFrame]
[ContextBridge]
interface Modules {
    // npm search: the best matches, an exact name match first.
    SearchPackages(query: PackageQuery) -> PackageSearchResults
    // Every published version, newest first, and the latest.
    GetPackageVersions(name: PackageName) -> PackageVersions
    // Adds a module at `version`, or at its latest version when omitted.
    AddModule(name: PackageName, version: VersionSpec?) -> number
    // Floating versions (`*`, `latest`) become the latest; ranges and other tags stay as given.
    SetModuleVersion(name: PackageName, version: VersionSpec) -> number
    RemoveModule(name: PackageName) -> number
}

[RendererAPI]
[Validator=MainFrame]
[ContextBridge]
interface Onboarding {
    // True if this window should offer the tour: it hasn't been finished or
    // dismissed, and no other window has offered it since launch.
    ShouldOfferTour() -> boolean
    // The tour was finished or dismissed. It stays available from Help.
    SetTourDone()
}

// Electron versions, running, bisect and editor types.
// Install state lives in `App.versions`, run status in `Window.run`.

zod_reference ReleaseList {
    import = "../../../../shared/stores"
    type = "ReleaseList"
    schema = "releaseListSchema"
}

zod_reference VersionList {
    import = "../../../../shared/stores"
    type = "VersionList"
    schema = "versionListSchema"
}

zod_reference VersionRefValue {
    import = "../../../../shared/stores"
    type = "VersionRefValue"
    schema = "versionRefSchema"
}

zod_reference OutputLines {
    import = "../../../../shared/stores"
    type = "OutputLines"
    schema = "outputLinesSchema"
}

zod_reference EditorTypes {
    import = "../../../../shared/stores"
    type = "EditorTypes"
    schema = "editorTypesSchema"
}

subtype VersionString = string(
    minLength: 1
    maxLength: 100
)

subtype BuildId = string(
    minLength: 1
    maxLength: 100
)

[RendererAPI]
[Validator=MainFrame]
[ContextBridge]
interface Versions {
    // Every known release, newest first. Fetch again when `App.versions.releasesRev` changes.
    GetReleases() -> ReleaseList
    // Fetches the release list from electronjs.org.
    RefreshReleases()
    // Sets this window's Electron version and downloads it if needed. Returns the Window rev.
    SetVersion(ref: VersionRefValue) -> number
    Download(version: VersionString)
    Remove(version: VersionString)
    // Downloads the given versions one at a time until done or stopped.
    DownloadAll(versions: VersionList)
    StopDownloadAll()
    // Deletes every download and local build except the ones windows use.
    DeleteAll()
    // Asks for a build folder. False when cancelled.
    AddLocalBuild() -> boolean
    RemoveLocalBuild(id: BuildId)
    // Downloads this window's version if it still isn't: the renderer calls it when the computer is back online.
    RetryDownload()
    // Copies this window's version number (a local build's name) to the clipboard.
    CopyVersion()
    // Clears `Window.versionNotice` once the renderer has shown it.
    DismissNotice(id: number)
    // Type definitions for this window's version, for Monaco. Null until available.
    GetTypes() -> EditorTypes?
    // The types for this window's version changed; call GetTypes again.
    [Event]
    TypesChanged()
}

// Running goes through the `run.toggle` command, so every trigger shares one path.
[RendererAPI]
[Validator=MainFrame]
[ContextBridge]
interface Run {
    // The console backlog. Lines at or below `Window.run.clearedSeq` are cleared.
    GetOutput() -> OutputLines
    ClearOutput()
    // New console lines, batched.
    [Event]
    Output(lines: OutputLines)

    StartBisect(good: VersionString, bad: VersionString, auto: boolean)
    BisectGood()
    BisectBad()
    BisectSkip()
    StopBisect()
    // Asks, then opens the GitHub comparison of the bisect result.
    OpenBisectCompare()
}

// GitHub sign-in and gists. The token never leaves main; the App
// store only carries `githubLogin`.

subtype GitHubToken = string(
    minLength: 1
    maxLength: 255
)

subtype GistDescription = string(
    minLength: 1
    maxLength: 256
)

subtype GistId = string(
    minLength: 32
    maxLength: 32
)

enum GitHubCredentialStorage {
    Encrypted = "encrypted"
    Weak = "weak"
    Unavailable = "unavailable"
}

structure GitHubSignInResult {
    login: string
    // False when the token is kept for this session only.
    persisted: boolean
}

structure GistLinkInfo {
    id: string
    url: string
}

structure GistRevisionInfo {
    sha: string
    date: string
    additions: number
    deletions: number
    // 0 for "Created", then 1, 2, 3… for "Revision N".
    n: number
}

structure GistHistoryInfo {
    id: string
    activeSha?: string
    // Oldest first.
    revisions: GistRevisionInfo[]
}

[RendererAPI]
[Validator=MainFrame]
[ContextBridge]
interface GitHub {
    GetCredentialStorage() -> GitHubCredentialStorage
    // Checks format, validity and the gist scope. `allowPlaintext` is the
    // user's consent to plaintext storage on Linux without a keyring.
    SignIn(token: GitHubToken, allowPlaintext: boolean) -> GitHubSignInResult
    // SignIn with the token on the clipboard. Main reads the clipboard, so
    // the token never reaches the renderer.
    SignInFromClipboard(allowPlaintext: boolean) -> GitHubSignInResult
    SignOut()
    // True when the clipboard holds something token-shaped.
    HasClipboardToken() -> boolean
    // The clipboard's text when all of it is a gist URL or ID, for the
    // open-gist field; null otherwise. Main reads the clipboard.
    ReadClipboardGist() -> string?
    OpenNewTokenPage()
    // A pending one-time notice, e.g. `decrypt-failed`.
    TakeNotice() -> string?
    // These act on this window's fiddle.
    Publish(description: GistDescription, isPublic: boolean) -> GistLinkInfo
    Update() -> GistLinkInfo
    Delete()
    GetHistory() -> GistHistoryInfo
    CopyShareLink(id: GistId)
}

// Renderer logs, crash reporting and update notices.

enum LogLevel {
    info
    warn
    error
}

subtype LogText = string(
    minLength: 0
    maxLength: 10000
)

[RendererAPI]
[Validator=MainFrame]
[ContextBridge]
interface AppPlatform {
    // Appends a renderer entry to main's JSON-lines log. Main redacts it.
    Log(level: LogLevel, message: LogText)
    // Whether main started Sentry; the renderer starts its SDK only then.
    IsCrashReportingEnabled() -> boolean
    // The update toast's action: opens the release page after confirmation.
    OpenUpdatePage()
    // True once, for the first window to ask: show the first-run notice that
    // crash reports are on. Recorded in state.json.
    TakeCrashReportsNotice() -> boolean
    // Relaunches the app, e.g. after a language change.
    Relaunch()
    // macOS: forgets every privacy grant (camera, microphone, …) after a
    // confirmation. False when cancelled.
    ResetPrivacyPermissions() -> boolean

    // Linux and MSIX: a newer release is out (daily GitHub releases check).
    [Event]
    UpdateAvailable(version: string)
}
